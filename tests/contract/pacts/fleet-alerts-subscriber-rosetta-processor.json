              {
                "match": "number"
              }
            ]
          },
          "$.detected_ts": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.kind": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^(HARSH_BRAKE|HARSH_ACCEL|SPEEDING|LOW_SOC)$"
              }
            ]
          },
          "$.severity": {
            "combine": "AND",
            "matchers": [

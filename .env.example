# Rosetta, settings for `docker compose up`.
#
#   cp .env.example .env
#
# .env is ignored by git. Never commit it.
#
# The values below are placeholders. They are long enough for the stack to start
# on a laptop, and they protect nothing. Replace every one of them before the
# stack is reachable by anybody else.
#
# How to generate real values:
#
#   openssl rand -hex 24      passwords (hex has no character that needs escaping
#                             inside a database or Redis URL)
#   openssl rand -hex 32      ROSETTA_JWT_SECRET (the API refuses less than 32 characters)
#
# One line that prints a complete set:
#
#   for k in POSTGRES_PASSWORD REDIS_PASSWORD MINIO_ROOT_PASSWORD ROSETTA_DEMO_PASSWORD \
#            GRAFANA_ADMIN_PASSWORD EMQX_NODE_COOKIE EMQX_DASHBOARD_PASSWORD; do
#     echo "$k=$(openssl rand -hex 24)"; done; echo "ROSETTA_JWT_SECRET=$(openssl rand -hex 32)"; echo "ROSETTA_METRICS_TOKEN=$(openssl rand -hex 32)"
#
# In production none of this comes from a file: the Helm chart reads a
# Kubernetes Secret that is filled by your secret manager (infra/helm/rosetta).

# ------------------------------------------------------------------ secrets
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password
MINIO_ROOT_USER=rosetta
MINIO_ROOT_PASSWORD=change-me-minio-password
# Signs the API's access tokens. At least 32 characters.
# Bearer token Prometheus sends to GET /metrics.
ROSETTA_METRICS_TOKEN=change-me-generate-with-openssl-rand-hex-32
ROSETTA_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Password of the demo accounts that the seed job creates (admin@rosetta.example and others).
ROSETTA_DEMO_PASSWORD=change-me-demo-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
EMQX_NODE_COOKIE=change-me-emqx-cookie
EMQX_DASHBOARD_PASSWORD=change-me-emqx-dashboard-password

# Optional. With a key the mapping agent lets a language model drive its tools;
# without one it runs the same tools in a fixed, deterministic order. Set the key
# for whichever provider you have and leave the others empty.
#   Google Gemini
GEMINI_API_KEY=
#   Anthropic Claude
ANTHROPIC_API_KEY=
# auto picks whichever key is set above. Or name one: anthropic | google | none
ROSETTA_LLM_PROVIDER=auto
# Optional. Overrides that provider's default model
# (anthropic: claude-opus-5-5, google: gemini-2.5-pro).
ROSETTA_LLM_MODEL=

# ----------------------------------------------------------------- settings
# Size of the synthetic fleet. The seed job and the simulator must agree, which
# is why both read this one value.
ROSETTA_VEHICLES=100000
# Cap on simulated events per second. 0 removes the cap.
SIM_MAX_EPS=5000
NORMALIZER_REPLICAS=2
ROSETTA_LOG_LEVEL=INFO
# Kafka disk budget, bytes per partition (78 partitions in total).
KAFKA_RETENTION_BYTES=33554432

# Ports on the host, all bound to 127.0.0.1.
API_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
MINIO_CONSOLE_PORT=9001
